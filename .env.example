ENVIRONMENT=development
PROJECT_NAME="Backend API"
API_V1_STR="/api/v1"
# DEBUG for verbose request tracing while diagnosing an issue.
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Copy to .env.local: these values run against the local stack in docker-compose.yml as they are. They are the
# addresses seen from the host, for running the API outside Docker; compose swaps in the service names for its
# containers. Production gets its settings from AWS (see infra/README.md), never from this file.

# S3Mock, the local S3 emulator: any credentials work, and the bucket exists from the start.
BUCKET_ENDPOINT=http://localhost:9090
BUCKET_ACCESS_KEY=local
BUCKET_SECRET_KEY=local-secret
BUCKET_NAME=wsi-slides
BUCKET_REGION=us-east-1

# The local PostgreSQL; its container is created with these same credentials. The password must not contain
# / " @ # ? or a space: they break the DSN that app/core/config.py builds.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=wsi
POSTGRES_PASSWORD=wsi
POSTGRES_DB=wsi

# Auth Configuration
JWT_SECRET=local_development_secret_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Over plain http the browser drops Secure cookies, so this stays false locally.
COOKIE_SECURE=false
# The administrator account created on first start by scripts/create_admin.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cell segmentation. Set to true only while the ml-worker stack runs, and start the backend with
# `docker compose --profile segmentation up -d --build`. Off, hotspots stay `pending` and everything else works.
SEGMENTATION_ENABLED=false
# The local Redis (compose's own `redis` service).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_TRANSPORT_OPTIONS={"visibility_timeout": 3600}

# Local, re-creatable copies of slides (OpenSlide needs filesystem paths).
SLIDE_CACHE_DIR=.slide-cache
