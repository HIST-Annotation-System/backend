ENVIRONMENT=development
PROJECT_NAME="Backend API"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
BUCKET_ENDPOINT=https://storage.googleapis.com
# Endpoint browsers use for presigned upload URLs (defaults to BUCKET_ENDPOINT).
BUCKET_PUBLIC_ENDPOINT=https://storage.googleapis.com
BUCKET_ACCESS_KEY=GOOGTESTKEY1234567890
BUCKET_SECRET_KEY=ABCDE1234567890FGHIJ1234567890KLMNO12345
BUCKET_NAME=my-gcs-bucket
BUCKET_REGION=europe-west3

# PostgreSQL started by docker compose (published on host port 5433).
DATABASE_URL=postgresql+psycopg://wsi:wsi@localhost:5433/wsi

# Local, re-creatable copies of slides (OpenSlide needs filesystem paths).
SLIDE_CACHE_DIR=.slide-cache
POSTGRES_USER=wsi
POSTGRES_PASSWORD=wsi
POSTGRES_DB=wsi
POSTGRES_HOST_PORT=5433

# Auth Configuration
JWT_SECRET=super_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_PASSWORD=admin123
