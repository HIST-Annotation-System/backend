ENVIRONMENT=development
PROJECT_NAME="Backend API"
API_V1_STR="/api/v1"
# DEBUG for verbose request tracing while diagnosing an issue.
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
# AWS S3; the bucket must already exist (it is never created by the app). `infra/` provisions it, and
# `terraform output -raw env_local` prints this block filled in.
BUCKET_ENDPOINT=https://s3.eu-north-1.amazonaws.com
BUCKET_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
BUCKET_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
BUCKET_NAME=my-s3-bucket
BUCKET_REGION=eu-north-1

# PostgreSQL on AWS RDS, provisioned by infra/. `terraform output -raw env_local` prints this block
# filled in, and compose passes it straight through: the containers use the same instance you do.
# The password must not contain / " @ # ? or a space: RDS rejects some of them and the rest break
# the DSN that app/core/config.py builds.
POSTGRES_SERVER=wsi-db.xxxxxxxxxxxx.eu-north-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=wsi
POSTGRES_PASSWORD=change_me_no_special_characters
POSTGRES_DB=wsi

# Auth Configuration
JWT_SECRET=super_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# The administrator account created on first start by scripts/create_admin.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Local, re-creatable copies of slides (OpenSlide needs filesystem paths).
SLIDE_CACHE_DIR=.slide-cache
